# Docker Compose environment for the weft stack.
#
# This file controls ONLY how the stack is wired at the Compose level — the
# reverse proxy and which host ports are published. Application config still
# lives in the plain files (weft.toml / livekit.yaml / Caddyfile); secrets are
# still duplicated there, not sourced from here.
#
# Compose reads this file automatically (`docker compose up -d`).

# ── Which services start ───────────────────────────────────────────────────
# A comma-separated list of Compose profiles.
#   caddy  (default) → run the bundled Caddy reverse proxy: automatic Let's
#                      Encrypt TLS on 80/443, weftd's HTTP stays internal.
#                      Omit it to DO NOT start Caddy — publish weftd's HTTP port
#                      on the host instead (see WEFT_HTTP_BIND below) and put
#                      your own TLS / proxy in front, or use it plain on a
#                      trusted LAN.
#   matrix           → also run the Matrix bridge: a companion Synapse homeserver
#                      plus the `weft-matrix` daemon. Setup is NOT just this flag
#                      (a key has to be pinned in weft.toml first) — follow
#                      MATRIX.md before adding it.
COMPOSE_PROFILES=caddy

# ── weftd HTTP exposure ────────────────────────────────────────────────────
# Interface + host port weftd's HTTP listener (the web client, /ws,
# /.well-known/weft, /media — all plain HTTP) is published on.
#
#   • With Caddy (default): keep 127.0.0.1 — loopback only, so the port is NOT
#     reachable from the network; Caddy fronts it on 443.
#   • Without Caddy: set WEFT_HTTP_BIND=0.0.0.0 to advertise it on every host
#     interface (or a specific IP). This is plain HTTP — terminate TLS upstream.
WEFT_HTTP_BIND=127.0.0.1
WEFT_HTTP_PORT=8081

# Quick recipe — disable Caddy and serve HTTP directly on the host:
#   COMPOSE_PROFILES=
#   WEFT_HTTP_BIND=0.0.0.0

# ── Matrix bridge (profile: matrix) ────────────────────────────────────────
# Interface + host port the companion homeserver's client/federation API is
# published on. Keep it on loopback when Caddy fronts it — Matrix federation
# needs real TLS on a public name, which Caddy provides (see MATRIX.md).
MATRIX_BIND=127.0.0.1
MATRIX_PORT=8008
