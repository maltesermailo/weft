# Caddy fronts the WEFT + LiveKit HTTP/WebSocket surfaces with automatic Let's
# Encrypt (needs public DNS for these names + ports 80/443 reachable). Edit the
# two site addresses below to your domains — they MUST MATCH deploy/weft.toml.
#
# QUIC is NOT proxied (a reverse proxy can't terminate weftd's UDP+TLS QUIC).
# weftd holds the QUIC cert itself — it reads Caddy's cert from the shared
# `caddy_data` volume (see the [tls] block in weft.toml). LiveKit's RTC *media*
# (UDP 50000-50020) is also direct, not proxied — only its signaling is here.

# The weftd HTTP surface: the embedded web client (/), same-origin /ws,
# /.well-known/weft (§10.2), /media (§13). reverse_proxy upgrades WebSockets
# transparently, so /ws needs no extra config.
weft.example.com {
	reverse_proxy weftd:8081
}

# LiveKit signaling (browsers connect wss://livekit.<domain> — this MUST MATCH
# [voice.livekit] url in weft.toml). Media rides UDP direct to the host.
livekit.weft.example.com {
	reverse_proxy livekit:7880
}

# ── Matrix bridge (../weft-matrix, optional) ─────────────────────────────────
# Uncomment and set your domain to make the companion homeserver reachable —
# federation needs a public name with real TLS, and this is what provides it.
# It MUST MATCH `server_name` in ../weft-matrix/homeserver.yaml.
#
# `host.docker.internal` — not a service name — because the bridge stack is a
# SEPARATE Compose project: Caddy reaches its published port through the host
# (`extra_hosts` in docker-compose.yml maps the name). weftd and LiveKit above are
# in this project, so those resolve directly.
#
# No /.well-known/matrix/server block is needed here: `serve_server_wellknown:
# true` has Synapse serve it, which is what tells remote servers to federate over
# 443 instead of 8448 (so 8448 never has to be opened). That only works because
# this block routes `https://<server_name>/` to Synapse.
#
# ── If `server_name` is your APEX domain instead ──
# `server_name: weft.example.com` gives MXIDs that match the WEFT network name
# (`@weft_…:weft.example.com`) — but then the APEX is the authority remote servers
# ask, and the apex serves weftd, not Synapse. So the delegation moves into the
# weftd block above, and Synapse's own `serve_server_wellknown` becomes dead
# weight (nothing queries it there).
#
# Both routes go in `handle` blocks: those are mutually exclusive and first-match,
# so the well-known cannot be swallowed by the proxy. A bare `reverse_proxy`
# alongside a `handle` would leave that to Caddy's directive ordering, which is
# not something to bet federation on.
#
#     weft.example.com {
#         handle /.well-known/matrix/* {
#             header Content-Type application/json
#             respond `{"m.server": "matrix.weft.example.com:443"}`
#         }
#         handle {
#             reverse_proxy weftd:8081
#         }
#     }
#
# The delegated target still needs this site block below (that is where remote
# servers actually connect, and whose certificate they validate) — it just no
# longer needs to serve the well-known.
#
# matrix.weft.example.com {
# 	reverse_proxy host.docker.internal:8008
# }
