# Synapse's logging config (a Python `logging.config.dictConfig` document).
#
# We ship one instead of letting Synapse generate it, for two reasons:
#
#  1. The generated one logs to a FILE, whose path Synapse builds with
#     `abspath("homeserver.log")` — relative to the process working directory,
#     which is `/` in this image and not writable by the 991 user it runs as.
#     That is a hard startup failure: `PermissionError: '/homeserver.log'`.
#  2. A container should log to stdout, so `docker compose logs synapse` is the
#     whole story and nothing accumulates inside the volume unrotated.
#
# Referenced by homeserver.yaml's `log_config`. Set `root.level: DEBUG` to debug a
# federation or appservice problem — it is very verbose.

version: 1

formatters:
  precise:
    format: "%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(message)s"

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
    stream: ext://sys.stdout

loggers:
  # Pinned to INFO because at DEBUG they drown everything else: every SQL
  # statement, and one line per HTTP request Synapse makes outbound.
  synapse.storage.SQL:
    level: INFO
  synapse.http.matrixfederationclient:
    level: INFO

root:
  level: INFO
  handlers: [console]

# Leave false: Synapse configures loggers of its own before reading this.
disable_existing_loggers: false
