# Docker Compose environment for the Matrix bridge stack.
#
# This stack is independent of ../weftd and reaches it over weftd's public name
# (`[weft] endpoint` in weft-matrix.toml), so nothing here refers to it.

# ── Secrets ────────────────────────────────────────────────────────────────
# This stack's own Postgres password — unrelated to weftd's. `openssl rand -hex 32`.
# weft-matrix.toml references it as `${POSTGRES_PASSWORD}`; homeserver.yaml has to
# repeat it literally, because Synapse has no environment expansion.
POSTGRES_PASSWORD=change-me-matrix-postgres-password

# ── Published ports ────────────────────────────────────────────────────────
# The companion homeserver's client + federation API. Published so a reverse proxy
# in another project (Caddy, in ../weftd) can front it; federation needs real TLS on a
# name. 0.0.0.0 is what makes it reachable from Caddy's container through the host
# — firewall it, or use the Docker bridge address (see ../weftd/.env).
MATRIX_BIND=0.0.0.0
MATRIX_PORT=8008
